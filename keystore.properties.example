# Copy to keystore.properties and fill in. That file is gitignored and must
# stay out of the repo. With it present, assembleNonRootRelease produces an
# APK that installs as is, with no separate signing step.
storeFile=release.keystore
storePassword=
keyAlias=moonlightvr
# Leave blank if the key uses the same password as the store
keyPassword=
