# Copy to keystore.properties and fill in. That file is gitignored and must
# stay out of the repo. With it present, assembleNonRootRelease produces an
# APK that installs as is, with no separate signing step.
storeFile=release.keystore
storePassword=
keyAlias=moonlightvr
# Leave blank if the key uses the same password as the store
keyPassword=

# Optional: where the report a problem screens send reports, and the token the
# collector checks (tools/report-worker). Both are baked into the APK, so they
# belong here rather than in gradle.properties, which is tracked. Leave them
# out and Send saves reports on the headset and says the build has no collector.
#reportUrl=https://moonlight-xr-reports.<account>.workers.dev/report
#reportToken=
