    <!-- Bug Report strings -->
    <string name="title_bug_report">回報問題</string>
    <string name="summary_bug_report">彙整您的說明、裝置資訊、串流設定與記錄檔，並傳送給開發團隊</string>
    <string name="category_about">關於</string>
    <string name="about_version">Moonlight XR %1$s，提交 %2$s</string>
    <string name="about_version_no_commit">Moonlight XR %1$s</string>
    <string name="title_about_licence">授權條款：GPLv3</string>
    <string name="bug_report_intro">請描述遇到的問題以及預期行為。報告將打包您的訊息、應用程式版本、頭戴裝置型號、串流設定與記錄檔，並傳送至 %1$s。\n\n記錄檔路徑：%2$s</string>
