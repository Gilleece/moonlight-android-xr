    <string name="title_checkbox_gamepad_touchpad_as_mouse">一律使用觸摸板控制滑鼠</string>
    <string name="summary_checkbox_gamepad_motion_sensors">在使用動態感測器模擬手把時啟用支援的主機以要求動態感測器資料，若動態感測器未在遊戲中使用，停用後可能會輕微降低電力和網路使用量。</string>
    <string name="videoformat_h264always">偏好 H.264</string>
    <string name="perf_overlay_hostprocessinglatency">主機處理延遲最小值/最大值/平均值：%1$.1f/%2$.1f/%3$.1f ms</string>
    <string name="summary_checkbox_gamepad_touchpad_as_mouse">強制手把觸摸板輸入以控制主機滑鼠，即使在使用觸摸板模擬手把時。</string>
    <string name="title_checkbox_gamepad_motion_sensors">一律使用手把動態感測器</string>
    <string name="videoformat_av1always">偏好 AV1 (實驗性)</string>
    <string name="toast_controller_type_changed">手把類型可能會因動態感測器模擬而變更</string>
    <string name="summary_checkbox_gamepad_motion_fallback">如果您連線的手把或 Android 版本不支援手把感測器，請使用裝置內建的動態感測器。
\n注意：啟用此選項可能會導致您的手把在主機被辨識為 PlayStation 控制器。</string>
    <string name="title_checkbox_gamepad_motion_fallback">模擬手把動態感測器支援</string>

    <!-- VR Settings -->
    <string name="category_vr_settings">VR 設定</string>
    <string name="category_vr_debug">VR 偵錯</string>
    <string name="title_enable_vr_mode">以 VR 模式串流</string>
    <string name="summary_enable_vr_mode">在沉浸式 VR 空間中的虛擬螢幕上顯示串流畫面。僅限頭戴式裝置，且是唯一支援 3D 效果的模式。</string>
    <string name="title_vr_head_locked">頭部鎖定螢幕</string>
    <string name="summary_vr_head_locked">將虛擬螢幕固定在視野正前方，而非錨定在真實空間世界中</string>
    <string name="title_seekbar_vr_distance">螢幕距離</string>
    <string name="summary_seekbar_vr_distance">虛擬螢幕與視點的距離</string>
    <string name="title_seekbar_vr_screen_size">螢幕寬度</string>
    <string name="summary_seekbar_vr_screen_size">虛擬螢幕的顯示寬度</string>
    <string name="title_seekbar_vr_curvature">螢幕曲率</string>
    <string name="summary_seekbar_vr_curvature">0 為平面，數值越高螢幕環繞弧度越大</string>
    <string name="suffix_seekbar_vr_meters">公尺</string>
    <string name="title_vr_pointer">使用控制器模擬滑鼠</string>
    <string name="summary_vr_pointer">使用控制器指向螢幕以移動主機滑鼠。扳機鍵為左鍵點擊，A 或 X 鍵為右鍵點擊，搖桿上下捲動。在需要原生滑鼠控制的遊戲中，可按下搖桿關閉指向功能。</string>
    <string name="title_vr_pointer_sleep">控制器靜止時暫停游標</string>
    <string name="summary_vr_pointer_sleep">控制器靜止幾秒後游標會隱藏，移動控制器或推動搖桿時恢復。關閉此項可讓游標保持啟用，即使游標不在螢幕上，搖桿也能捲動。</string>
    <string name="title_vr_show_ray">顯示控制器射線</string>
    <string name="summary_vr_show_ray">從控制器射向螢幕的光束。玩光槍遊戲時可將其關閉：落點處的光點仍會保留，按鍵照常生效；開啟面板時射線會重新出現，螢幕下方的射線按鈕可在本次階段中切換它。</string>
    <string name="title_vr_controller_model">顯示控制器</string>
    <string name="summary_vr_controller_model">在每隻手中真實控制器的位置繪製一個簡單的控制器模型。穿透模式下不顯示，因為此時可以看到真實控制器；改用手勢追蹤時也不顯示。</string>
    <string name="title_vr_head_aim">頭部控制滑鼠</string>
    <string name="summary_vr_head_aim">僅在螢幕鎖定到頭部時生效：轉動頭部會像遊戲的視角控制一樣移動滑鼠，適合第一人稱遊戲。控制器游標和實體滑鼠仍可同時使用。開啟面板時會暫停，螢幕下方的頭部控制按鈕可在本次階段中切換它。</string>
    <string name="title_seekbar_vr_head_aim_sensitivity">頭部控制靈敏度</string>
    <string name="summary_seekbar_vr_head_aim_sensitivity">頭部每轉動一度時滑鼠移動的距離。配合遊戲本身的滑鼠靈敏度調整，直到視角轉動的幅度與頭部一致。頭戴裝置內設定面板的「螢幕」分頁調整的是同一個數值。</string>
    <string name="title_seekbar_vr_head_aim_deadzone">頭部控制死區</string>
    <string name="summary_seekbar_vr_head_aim_deadzone">頭部轉動慢於此速度時不傳送任何移動，可避免頭部靜止時追蹤抖動移動滑鼠。設為 0 則傳送所有移動。</string>
    <string name="title_vr_gamepad_toggle">遊戲控制器模式快速鍵</string>
    <string name="summary_vr_gamepad_toggle">目前：%s。遊戲控制器模式會把兩個控制器合起來在電腦上作為一個 Xbox 控制器：搖桿、A、B、X、Y 鍵、扳機、握把作為肩鍵、搖桿按下，以及左手選單鍵作為 Start。它只能在階段中透過設定面板的「顯示」分頁或螢幕下方的遊戲控制器按鈕開啟，每次階段開始時控制器都是游標。之後可以用此快速鍵在兩者之間切換。選擇搖桿或扳機與握把時，這些按鍵傳給遊戲會稍晚一點，因為快速鍵要先判斷它們是不是在按快速鍵。</string>
    <string name="vr_gamepad_toggle_menu_grip">按住左手選單鍵和左手握把</string>
    <string name="vr_gamepad_toggle_sticks">同時按下兩個搖桿 (L3 + R3)</string>
    <string name="vr_gamepad_toggle_triggers_grips">同時握緊兩個扳機和兩個握把</string>
    <string name="title_vr_click_sound">按下面板時發出點擊聲</string>
    <string name="summary_vr_click_sound">在頭戴裝置中按下面板、按鈕或按鍵時發出短促的點擊聲。它透過系統音效播放，與串流音訊分開。</string>
    <string name="title_vr_gaze">注視瞄準 (Look to point)</string>
    <string name="summary_vr_gaze">在支援眼球追蹤的頭戴裝置上，透過注視螢幕進行瞄準，用任一隻手捏合手指點擊。按下控制器上的按鍵後由控制器接管游標，直到將其放下；若眼球追蹤遺失 10 秒，將改由雙手指向，直到恢復。</string>
    <string name="title_vr_hand_tracking">手勢追蹤</string>
    <string name="summary_vr_hand_tracking">放下控制器時可透過手勢指向與捏合操作。關閉此項可僅使用控制器。在串流階段中，用拇指和食指快速捏合三次，可鎖定手勢互動而無需離開遊戲；再快速捏合三次即可解鎖。</string>
    <string name="vr_hand_hint_title">手勢追蹤已開啟。</string>
    <string name="vr_hand_hint_body">用拇指和食指快速捏合三次即可鎖定手勢，避免誤捏造成點擊；再快速捏合三次即可解鎖。</string>
    <string name="vr_hand_hint_never">不再顯示</string>
    <string name="vr_kofi_title">在 Ko-fi 上支持 Moonlight XR</string>
    <string name="vr_kofi_scan">用手機掃描此 QR 碼。</string>
    <string name="vr_kofi_free">完全自願：Moonlight XR 免費，並將一直免費。</string>
    <string name="vr_kofi_close">關閉</string>
    <string name="title_vr_reset_pose">重設螢幕位置</string>
    <string name="summary_vr_reset_pose">將螢幕恢復至上方設定的距離和寬度，復原使用控制器進行的移動或縮放操作</string>
    <string name="toast_vr_reset_pose">螢幕位置已重設</string>
    <string name="title_vr_passthrough">穿透模式 (Passthrough)</string>
    <string name="summary_vr_passthrough">開啟環境穿透。請注意此模式會消耗更多系統資源，若串流出現延遲或卡頓請停用</string>
    <string name="title_vr_environment">環境</string>
    <string name="summary_vr_environment">目前：%s。階段開始時螢幕周圍的環境。在頭戴裝置中透過螢幕下方的按鈕選擇環境，也會變更此設定。</string>
    <string name="title_vr_doff_grace">摘下頭戴裝置時保留串流一分鐘</string>
    <string name="summary_vr_doff_grace">短暫摘下頭戴裝置時，串流會靜音等待最多 60 秒，重新戴上後繼續。關閉後，摘下頭戴裝置會立即結束串流。</string>
    <string name="vr_environment_passthrough">穿透 (Passthrough)</string>
    <string name="vr_environment_void">黑色虛空 (Black void)</string>
    <string name="vr_environment_home_theater">家庭劇院 (Home Theater)</string>
    <string name="vr_environment_grand_cinema">大戲院 (Grand Cinema)</string>
    <string name="vr_environment_synthwave">合成波 (Synthwave)</string>
    <string name="title_vr_depth_source">即時 3D 模式</string>
    <string name="summary_vr_depth_source">選擇即時 3D 模式，包含多種測試圖樣。</string>
    <string name="title_vr_env_res">虛擬環境解析度</string>
    <string name="summary_vr_env_res">螢幕周圍 3D 虛擬房間的渲染清晰度。畫質越高越消耗 GPU 效能。極致為實驗性功能，可能導致延遲或掉影格。</string>
    <string name="title_seekbar_vr_picture_brightness">畫面亮度</string>
    <string name="summary_seekbar_vr_picture_brightness">提高或降低頭戴裝置中整個畫面的亮度。0 為串流的原始畫面。頭戴裝置內設定面板的「畫面」分頁調整的是同樣的四個數值。</string>
    <string name="title_seekbar_vr_picture_contrast">畫面對比</string>
    <string name="summary_seekbar_vr_picture_contrast">以中灰為中心拉開或收攏畫面的明暗層次。100% 為串流的原始畫面。</string>
    <string name="title_seekbar_vr_picture_gamma">畫面伽瑪</string>
    <string name="summary_seekbar_vr_picture_gamma">高於 1.00 會提亮中間調與暗部，同時不會讓黑色和白色發灰，對偏暗的遊戲通常比調亮度更合適。1.00 為串流的原始畫面。</string>
    <string name="title_seekbar_vr_picture_saturation">畫面飽和度</string>
    <string name="summary_seekbar_vr_picture_saturation">畫面色彩的濃淡。0% 為黑白，100% 為串流的原始畫面。</string>
    <string name="title_vr_sharpening">虛擬螢幕銳化</string>
    <string name="summary_vr_sharpening">在頭戴裝置合成器中銳化虛擬螢幕。在受支援的頭戴裝置上幾乎不增加額外開銷；若執行階段不支援此擴充功能則自動略過。</string>
    <string name="title_vr_supersampling">虛擬螢幕超取樣</string>
    <string name="summary_vr_supersampling">在頭戴裝置合成器中對虛擬螢幕進行超取樣，讓螢幕顯示得比串流畫面小時閃爍的細節保持穩定。會佔用少量合成器 GPU 時間；若執行階段不支援此擴充功能則自動略過。</string>
    <string name="title_vr_depth_debug">顯示深度圖</string>
    <string name="summary_vr_depth_debug">將視訊渲染為灰階深度圖而非正常畫面，用於檢查 3D 深度品質</string>
    <string name="title_vr_eye_swap">對調左右眼</string>
    <string name="summary_vr_eye_swap">在立體模式下對調左眼與右眼的影像</string>
    <string name="vr_unavailable_flat">無法連線至頭戴裝置的 OpenXR 執行階段，因此串流將以平面面板顯示。請更新頭戴裝置系統軟體，或在設定中關閉「以 VR 模式串流」。</string>
    <string name="vr_unavailable_flat_reason">%1$s\n串流將以平面面板顯示。請更新頭戴裝置系統軟體，或在設定中關閉「以 VR 模式串流」。</string>
