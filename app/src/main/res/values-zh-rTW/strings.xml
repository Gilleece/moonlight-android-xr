    <!-- VR Debug strings -->
    <string name="title_vr_file_log">儲存記錄檔</string>
    <string name="summary_vr_file_log">在 Download/MoonlightXR 保留純文字記錄檔，頭戴裝置上的檔案管理器可以找到它，並可將其附加到錯誤回報中。檔案達 5 MB 時會輪替至 moonlight.previous.log，兩者合計絕不超過 10 MB。變更此設定後請重新啟動應用程式以生效。</string>
    <string name="title_seekbar_vr_inference_cadence">每秒深度更新次數</string>
    <string name="summary_seekbar_vr_inference_cadence">3D 每秒產生的深度圖數量。數值越低頭戴裝置負載越小，但深度延遲會更明顯。頭戴裝置跟不上時，會先將此值暫時減半，然後才降低顯示更新率。</string>
    <string name="suffix_seekbar_vr_inference_cadence">次/秒</string>
    <string name="title_seekbar_vr_separation">雙眼立體視差</string>
    <string name="summary_seekbar_vr_separation">兩眼視野相隔多遠 (以影格寬度的百分比表示)。超過約 0.5% 後畫面看起來不會更深，反而更容易造成眼睛疲勞。</string>
    <string name="suffix_seekbar_vr_percent">％</string>
    <string name="suffix_seekbar_vr_head_aim_sensitivity">像素/度</string>
    <string name="suffix_seekbar_vr_head_aim_deadzone">度/秒</string>
    <string name="gen1_warning_title">偵測到上一代頭戴裝置</string>
    <string name="gen1_warning_text">此應用程式專為 Quest 3 / Pico 4 Ultra 或更新的頭戴裝置設計。在 Quest 2 / Pico 4 等早期世代頭戴裝置上的效能尚未充分測試，預期表現可能不佳。已自動套用較低的效能設定檔以協助維持良好體驗。關閉即時 3D 能大幅提升效能，但這可能正是您下載此應用程式的原因！特此溫馨提醒，祝您使用愉快！</string>
    <string name="warning_dialog_never_again">不再顯示此提示</string>
    <string name="title_enable_gl_render_path">透過 OpenGL 渲染 (實驗性)</string>
    <string name="summary_enable_gl_render_path">在顯示前將解碼後的視訊導向 OpenGL 紋理。視覺效果應與一般渲染完全相同。開啟此項時，HDR 串流將進行色調限制。</string>

