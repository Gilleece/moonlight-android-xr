    <string name="vr_kofi_close">关闭</string>
    <string name="title_vr_reset_pose">重置屏幕位置</string>
    <string name="summary_vr_reset_pose">将屏幕恢复至上方设定的距离和宽度，撤销手柄拖拽或缩放操作</string>
    <string name="toast_vr_reset_pose">屏幕位置已重置</string>
    <string name="title_vr_passthrough">透视模式 (Passthrough)</string>
    <string name="summary_vr_passthrough">开启穿透现实环境。请注意此模式会占用更多系统资源，若串流出现卡顿请关闭</string>
    <string name="title_vr_environment">环境</string>
    <string name="summary_vr_environment">当前：%s。会话开始时屏幕周围的环境。在头显中通过屏幕下方的按钮选择环境，也会改变此设置。</string>
    <string name="title_vr_doff_grace">摘下头显时保留串流一分钟</string>
    <string name="summary_vr_doff_grace">短暂摘下头显时，串流会静音等待最多 60 秒，重新戴上后继续。关闭后，摘下头显会立即结束串流。</string>
