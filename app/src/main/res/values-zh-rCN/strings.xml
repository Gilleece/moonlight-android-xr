    <string name="category_vr_settings">VR 设置</string>
    <string name="category_vr_debug">VR 调试</string>
    <string name="title_enable_vr_mode">以 VR 模式串流</string>
    <string name="summary_enable_vr_mode">在沉浸式 VR 空间中的虚拟屏幕上显示串流画面。仅适用于头显设备，且是唯一支持 3D 效果的模式。</string>
    <string name="title_vr_head_locked">头动锁定屏幕</string>
    <string name="summary_vr_head_locked">将虚拟屏幕固定在视野正前方，而不是锚定在真实空间世界中</string>
    <string name="title_seekbar_vr_distance">屏幕距离</string>
    <string name="summary_seekbar_vr_distance">虚拟屏幕与视点的距离</string>
    <string name="title_seekbar_vr_screen_size">屏幕宽度</string>
    <string name="summary_seekbar_vr_screen_size">虚拟屏幕的显示宽度</string>
    <string name="title_seekbar_vr_curvature">屏幕曲率</string>
    <string name="summary_seekbar_vr_curvature">0 为平面，数值越高屏幕环绕弧度越大</string>
    <string name="suffix_seekbar_vr_meters">米</string>
    <string name="title_vr_pointer">使用手柄模拟鼠标</string>
    <string name="summary_vr_pointer">使用手柄指向屏幕以移动主机鼠标。扳机键为左键点击，A 或 X 键为右键点击，摇杆上下滚动。在需要原生鼠标控制的游戏中，可按下摇杆关闭指向功能。</string>
    <string name="title_vr_pointer_sleep">手柄静止时暂停指针</string>
    <string name="summary_vr_pointer_sleep">手柄静止几秒后指针会隐藏，移动手柄或推动摇杆时恢复。关闭此项可让指针保持激活，即使指针不在屏幕上，摇杆也能滚动。</string>
    <string name="title_vr_show_ray">显示手柄射线</string>
    <string name="summary_vr_show_ray">从手柄射向屏幕的光束。玩光枪游戏时可将其关闭：落点处的光点仍会保留，按键照常生效；打开面板时射线会重新出现，屏幕下方的射线按钮可在本次会话中切换它。</string>
    <string name="title_vr_controller_model">显示手柄</string>
    <string name="summary_vr_controller_model">在每只手中真实手柄的位置绘制一个简单的手柄模型。透视模式下不显示，因为此时可以看到真实手柄；改用手势追踪时也不显示。</string>
    <string name="title_vr_head_aim">头部控制鼠标</string>
    <string name="summary_vr_head_aim">仅在屏幕锁定到头部时生效：转动头部会像游戏的视角控制一样移动鼠标，适合第一人称游戏。手柄指针和真实鼠标仍可同时使用。打开面板时会暂停，屏幕下方的头部控制按钮可在本次会话中切换它。</string>
    <string name="title_seekbar_vr_head_aim_sensitivity">头部控制灵敏度</string>
    <string name="summary_seekbar_vr_head_aim_sensitivity">头部每转动一度时鼠标移动的距离。配合游戏自身的鼠标灵敏度调整，直到视角转动的幅度与头部一致。头显内设置面板的“屏幕”标签页调整的是同一个数值。</string>
    <string name="title_seekbar_vr_head_aim_deadzone">头部控制死区</string>
    <string name="summary_seekbar_vr_head_aim_deadzone">头部转动慢于此速度时不发送任何移动，可避免头部静止时追踪抖动移动鼠标。设为 0 则发送所有移动。</string>
    <string name="title_vr_gamepad_toggle">游戏手柄模式快捷键</string>
    <string name="summary_vr_gamepad_toggle">当前：%s。游戏手柄模式会把两个手柄合起来在电脑上作为一个 Xbox 手柄：摇杆、A、B、X、Y 键、扳机、握把作为肩键、摇杆按下，以及左手菜单键作为 Start。它只能在会话中通过设置面板的“显示”标签页或屏幕下方的游戏手柄按钮开启，每次会话开始时手柄都是指针。之后可以用此快捷键在两者之间切换。选择摇杆或扳机与握把时，这些按键传给游戏会稍晚一点，因为快捷键要先判断它们是不是在按快捷键。</string>
    <string name="vr_gamepad_toggle_menu_grip">按住左手菜单键和左手握把</string>
    <string name="vr_gamepad_toggle_sticks">同时按下两个摇杆 (L3 + R3)</string>
    <string name="vr_gamepad_toggle_triggers_grips">同时握紧两个扳机和两个握把</string>
    <string name="title_vr_click_sound">按下面板时发出点击声</string>
    <string name="summary_vr_click_sound">在头显中按下面板、按钮或按键时发出短促的点击声。它通过系统声音播放，与串流音频分开。</string>
    <string name="title_vr_gaze">注视点瞄准 (Look to point)</string>
    <string name="summary_vr_gaze">在支持眼动追踪的头显上，通过注视屏幕进行瞄准，用任意一只手捏合手指点击。按下手柄上的按键后由手柄接管指针，直到将其放下；如果眼动追踪丢失 10 秒，将改由双手指向，直到恢复。</string>
    <string name="title_vr_hand_tracking">手势追踪</string>
    <string name="summary_vr_hand_tracking">放下手柄时可通过手势指向和捏合操作。关闭此项可仅使用手柄。在串流会话中，用拇指和食指快速捏合三次，可锁定手势交互而无需退出游戏；再快速捏合三次即可解锁。</string>
    <string name="vr_hand_hint_title">手势追踪已开启。</string>
    <string name="vr_hand_hint_body">用拇指和食指快速捏合三次即可锁定手势，避免误捏造成点击；再快速捏合三次即可解锁。</string>
    <string name="vr_hand_hint_never">不再显示</string>
