    <!-- VR Debug strings -->
    <string name="title_vr_file_log">保存日志文件</string>
    <string name="summary_vr_file_log">在头显的 Download/MoonlightXR 目录下保留纯文本日志，方便文件管理器查找并附入错误报告。日志中可能包含您电脑在局域网中的名称和地址。单文件达到 5 MB 时会自动轮转为 moonlight.previous.log，两者总占用不会超过 10 MB。更改此设置后需重启应用方可生效。</string>
    <string name="title_seekbar_vr_inference_cadence">每秒深度更新次数</string>
    <string name="summary_seekbar_vr_inference_cadence">3D 每秒生成的深度图数量。数值越低头显负载越小，但深度变化的延迟会更明显。头显跟不上时，会先将此值临时减半，然后才降低显示刷新率。</string>
    <string name="suffix_seekbar_vr_inference_cadence">次/秒</string>
    <string name="title_seekbar_vr_separation">双目立体视差</string>
    <string name="summary_seekbar_vr_separation">左右眼视角的视差间距（占画面宽度的百分比）。超过约 0.5% 后 3D 深度不会进一步增强，反而更容易引起视觉疲劳。</string>
    <string name="suffix_seekbar_vr_percent">％</string>
    <string name="suffix_seekbar_vr_head_aim_sensitivity">像素/度</string>
    <string name="suffix_seekbar_vr_head_aim_deadzone">度/秒</string>
    <string name="gen1_warning_title">检测到上一代头显设备</string>
    <string name="gen1_warning_text">本应用专为 Quest 3 / Pico 4 Ultra 及更新的头显优化。在 Quest 2 / Pico 4 等早期头显上的性能表现尚未充分测试且预计较低。应用已自动应用较低的性能配置方案以尽量保障流畅体验。关闭实时 3D 可大幅提升性能，但这可能正是您下载此应用的原因！特此提示，祝您使用愉快！</string>
    <string name="warning_dialog_never_again">不再提示</string>
    <string name="title_enable_gl_render_path">通过 OpenGL 渲染 (实验性)</string>
    <string name="summary_enable_gl_render_path">在显示前将解码后的视频路由通过 OpenGL 纹理。显示效果与普通渲染一致。开启此项时，HDR 串流将进行色调截断。</string>

